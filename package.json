{
	"name": "is-down",
	"version": "0.0.0-semantic-release",
	"description": "Check whether developer services like npm, GitHub, and Vercel are down using their official status pages",
	"keywords": [
		"status",
		"statuspage",
		"outage",
		"incident",
		"downtime",
		"cli",
		"npm",
		"github"
	],
	"license": "MIT",
	"repository": "privatenumber/is-down",
	"author": {
		"name": "Hiroki Osame",
		"email": "hiroki.osame@gmail.com"
	},
	"files": [
		"dist",
		"docs",
		"skills",
		"NOTICE"
	],
	"type": "module",
	"sideEffects": false,
	"bin": "./dist/cli/index.mjs",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./providers": {
			"types": "./dist/providers/index.d.mts",
			"default": "./dist/providers/index.mjs"
		},
		"./providers.json": "./dist/providers/providers.json"
	},
	"packageManager": "pnpm@12.15.0",
	"scripts": {
		"build": "pkgroll --clean-dist",
		"cli": "node src/cli/index.ts",
		"lint": "lintroll --cache --git",
		"test": "node tests/index.ts",
		"type-check": "tsc",
		"prepack": "pnpm build && clean-pkg-json",
		"test:live": "node tests/live.ts",
		"import-providers": "node scripts/import-providers/index.ts",
		"generate-providers": "node scripts/generate-providers.ts",
		"audit-status": "node scripts/audit-status.ts"
	},
	"engines": {
		"node": ">=22.8"
	},
	"devDependencies": {
		"@sentry/status-page-list": "^0.6.1",
		"@types/node": "^26.6.5",
		"ansis": "^4.4.0",
		"clean-pkg-json": "^2.0.0",
		"cleye": "3.0.0-beta.2",
		"esbuild": "^0.28.2",
		"isupmap": "github:Jaironlanda/isupmap#0b78646b79dc7a635f0aae98a942b5003322eff6",
		"lintroll": "^1.32.1",
		"manten": "^2.0.2",
		"pkgroll": "^2.29.0",
		"typescript": "^6.0.3"
	}
}
